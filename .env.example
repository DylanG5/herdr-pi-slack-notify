# Slack Workflow Builder "From a webhook" trigger URL. The URL normally starts
# with https://hooks.slack.com/triggers/ and must be treated as a secret.
SLACK_WEBHOOK_URL=

# Human-readable label shown in test notifications. The Slack workflow itself
# determines the actual destination channel.
HERDR_SLACK_CHANNEL=#agent-notifications

# Notify only after the Pi terminal has remained unseen for this many seconds.
HERDR_SLACK_DELAY_SECONDS=300

# "final" includes Pi's latest assistant text; "ready" sends metadata only.
HERDR_SLACK_BODY_MODE=final

# Maximum number of final-message characters placed in Slack (500-2800).
HERDR_SLACK_MAX_FINAL_CHARS=2600

# Redact common token formats from final messages before posting.
HERDR_SLACK_REDACT_SECRETS=1

# Set to 0/false/off to suppress notifications without unlinking the plugin.
HERDR_SLACK_ENABLED=1

# Optional override when Pi stores sessions somewhere nonstandard.
# PI_SESSION_ROOT=/Users/dylan.garner/.pi/agent/sessions
